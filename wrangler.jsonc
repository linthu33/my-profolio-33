{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-vector-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",

  // AI Binding (Workers AI အတွက်)
  "ai": {
    "binding": "AI",
  },

  // Vectorize Binding (သင်ပေးထားသော Index နာမည် "pofolio-index" ဖြင့် ချိတ်ဆက်ရန်)
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "pofolio-index",
    },
  ],
}
